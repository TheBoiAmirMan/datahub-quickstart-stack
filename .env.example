# DataHub versions
DATAHUB_VERSION=v1.7.0
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0

# Published host ports
DATAHUB_MAPPED_FRONTEND_PORT=9002
DATAHUB_MAPPED_GMS_PORT=58080
DATAHUB_ELASTIC_PORT=9200

# Replace every change-me value before starting the stack
DATAHUB_SYSTEM_CLIENT_SECRET=change-me
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=change-me
DATAHUB_TOKEN_SERVICE_SALT=change-me
DATAHUB_FRONTEND_SECRET=change-me
DATAHUB_CREATE_USER_PASSWORD=change-me

# MySQL credentials
MYSQL_USER=datahub
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Present in the upstream quickstart environment; Neo4j is not enabled here
NEO4J_PASSWORD=change-me

